    truncated_amount = has_truncated_amount(cleaned)
    broken_end = has_broken_end(cleaned)
    cut_word = has_cut_word(cleaned)

    valid = (
        cleaned != ""
        and all_sections
        and legal_ok
        and long_ok
        and amount_ok
        and not truncated_amount
