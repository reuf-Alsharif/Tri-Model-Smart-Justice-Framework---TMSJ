def remove_prompt_noise(text):
    noise_markers = [
        "أنت محلل قانوني",
        "القضية:",
        "### Instruction:",
        "### Facts:",
        "### Reasons:",
        "أنشئ سيناريو جديد",
    ]

    for marker in noise_markers:
