def clean_text(text):

    if text is None:
        return ""

    text = str(text)

    # lowercase
    text = text.lower()

    # إزالة التشكيل
    text = re.sub(
        r'[\u0617-\u061A\u064B-\u0652]',
        '',
        text
    )

    # إزالة الرموز
    text = re.sub(
        r'[^\w\s]',
        ' ',
        text
    )

    # إزالة الأرقام
    text = re.sub(
        r'\d+',
        ' ',
        text
    )

    # ========================================================
    # LEGAL KEYWORD BOOSTING
    # ========================================================

    legal_terms = {

    # ====================================================
    # STRONG ACCEPTANCE
    # ====================================================

    "عقد": " عقد_قوي ",

    "اتفاقية": " عقد_قوي ",

    "فاتورة": " اثبات_مالي ",

    "فواتير": " اثبات_مالي ",

    "محضر استلام": " استلام_رسمي ",

    "محاضر الاستلام": " استلام_رسمي ",

    "اقر": " اقرار ",

    "أقر": " اقرار ",

    "اقرت": " اقرار ",

    "أقرت": " اقرار ",

    # ====================================================
    # NEGATIVE LEGAL SIGNALS
    # ====================================================

    "لم يقدم": " غياب_اثبات ",

    "عدم تقديم": " غياب_اثبات ",

    "لا يوجد": " غياب_اثبات ",

    "عدم وجود": " غياب_اثبات ",

    "عدم ثبوت": " غياب_اثبات ",

    "عدم كفاية": " غياب_اثبات ",

    "ينكر": " نفي_قوي ",

    "قوة قاهرة": " دفع_قوي ",

    "رفض": " رفض_صريح ",
}
    for k, v in legal_terms.items():

        text = text.replace(
            k,
            v
        )

    # ========================================================
    # REMOVE LEGAL FILLERS
    # ========================================================

    remove_phrases = [

        "بعد الاطلاع",
        "وحيث إن",
        "لدى الدائرة",
        "فإن الدائرة",
        "وبعد التأمل",
        "وبعد دراسة أوراق الدعوى",
        "بعد دراسة القضية",
        "وبناء عليه",
        "لذلك حكمت الدائرة",
    ]

    for phrase in remove_phrases:

        text = text.replace(
            phrase,
            ""
        )

    # تنظيف الفراغات
    text = re.sub(
        r'\s+',
        ' ',
        text
    )

    return text.strip()

