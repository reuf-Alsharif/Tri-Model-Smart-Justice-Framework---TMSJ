# ============================================================
# SMART LEGAL EXPLANATION GENERATOR
# ============================================================

def generate_legal_reasoning(prediction, cleaned_text):

    # ========================================================
    # ACCEPTED
    # ========================================================

    if prediction == "accepted":

        reasons = []

        if "عقد_قوي" in cleaned_text:

            reasons.append(
                "ثبوت العلاقة التعاقدية"
            )

        if "اثبات_مالي" in cleaned_text:

            reasons.append(
                "وجود مستندات مالية مؤيدة"
            )

        if "استلام_رسمي" in cleaned_text:

            reasons.append(
                "ثبوت استلام الأعمال أو البضاعة"
            )

        if "اقرار" in cleaned_text:

            reasons.append(
                "وجود إقرار من المدعى عليه"
            )

        if len(reasons) == 0:

            reasons.append(
                "وجود مؤشرات قانونية داعمة للمطالبة"
            )

        return (
            "تم قبول الدعوى بسبب "
            + " و ".join(reasons)
            + "."
        )

    # ========================================================
    # REJECTED
    # ========================================================

    elif prediction == "rejected":

        reasons = []

        if "غياب_اثبات" in cleaned_text:

            reasons.append(
                "عدم كفاية الأدلة"
            )

        if "نفي_قوي" in cleaned_text:

            reasons.append(
                "وجود دفوع مؤثرة من المدعى عليه"
            )

        if "دفع_قوي" in cleaned_text:

            reasons.append(
                "وجود سبب نظامي أو قوة قاهرة"
            )

        if len(reasons) == 0:

            reasons.append(
                "ضعف الإثبات القانوني"
            )

        return (
            "تم رفض الدعوى بسبب "
            + " و ".join(reasons)
            + "."
        )

    # ========================================================
    # PARTIAL
    # ========================================================

    elif prediction == "partial":

