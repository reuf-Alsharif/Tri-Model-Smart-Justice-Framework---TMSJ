def explain_case(case_text):


    cleaned = clean_text(case_text)


    prediction = model.predict(
        [cleaned]
    )[0]

    # --------------------------------------------------------
    # ACCEPTED
    # --------------------------------------------------------

    strong_accept = (

        (
            "عقد_قوي" in cleaned
            or
            "استلام_رسمي" in cleaned
        )

        and

        "اثبات_مالي" in cleaned
    )

    # --------------------------------------------------------
    # REJECTED
    # --------------------------------------------------------

    strong_reject = (

        "غياب_اثبات" in cleaned

        and

        "عقد_قوي" not in cleaned

        and

        "استلام_رسمي" not in cleaned
    )

    # --------------------------------------------------------
    # PARTIAL
    # --------------------------------------------------------

    strong_partial = (

        (

            "المبلغ المتبقي" in cleaned

            or

            "المتبقي" in cleaned

            or

            "جزء" in cleaned

            or

            "اعترض" in cleaned

            or

            "تدقيق الحسابات" in cleaned

            or

            "سدد" in cleaned
        )

        and

        "عقد_قوي" in cleaned
    )

    # ========================================================
    # APPLY RULES
    # ========================================================

    # partial أولاً
    if strong_partial:

        prediction = "partial"

    # قبول قوي
    elif strong_accept:

        prediction = "accepted"

    # رفض قوي
    elif strong_reject:

        prediction = "rejected"

    # ========================================================
    # MODEL OBJECTS
    # ========================================================

    vectorizer = model.named_steps[
        "tfidf"
    ]

    classifier = model.named_steps[
        "clf"
    ]

    X = vectorizer.transform(
        [cleaned]
    )

    # ========================================================
    # CONFIDENCE SCORE
    # ========================================================

    decision = classifier.decision_function(X)

    if np.ndim(decision) == 1:

        confidence = abs(
            decision[0]
        )

    else:

        confidence = np.max(
            np.abs(decision)
        )

    confidence = float(confidence)

    confidence = min(
        confidence * 20,
        100
    )

    confidence = round(
        confidence,
        2
    )

    # ========================================================
    # UNCERTAIN CASES
    # ========================================================

    if confidence < 25 and prediction not in [
        "accepted",
        "rejected",
        "partial"
    ]:

        prediction = "uncertain"

    # ========================================================
    # IMPORTANT FEATURES
    # ========================================================

    feature_names = (
        vectorizer
        .get_feature_names_out()
    )

    weights = X.toarray()[0]

    important = []

    for idx, value in enumerate(weights):

        if value > 0:

            coef = classifier.coef_[0][idx]

            score = value * coef

            important.append(

                (
                    feature_names[idx],
                    score
                )
            )

    important = sorted(

        important,

        key=lambda x: abs(x[1]),

        reverse=True
    )

    top_words = [
        w[0]
        for w in important[:10]
    ]

    # ========================================================
    # DISPLAY RESULTS
    # ========================================================

    print()
    print("=" * 60)
    print("LEGAL CASE ANALYSIS")
    print("=" * 60)

    print(
        "Prediction:",
        prediction
    )

    print(
        "Confidence:",
        f"{confidence}%"
    )

    print()

    # ========================================================
    # EXPLANATION
    # ========================================================

    if prediction == "accepted":

        print("Explanation:")

        print(
            "تم تصنيف القضية كمقبولة "
            "لوجود أدلة قوية مثل العقود "
            "أو الفواتير أو محاضر الاستلام."
        )

    elif prediction == "rejected":

        print("Explanation:")

        print(
            "تم تصنيف القضية كمرفوضة "
            "بسبب ضعف الإثبات أو "
            "عدم كفاية الأدلة المقدمة."
        )

    elif prediction == "partial":

        print("Explanation:")

        print(
            "تم تصنيف القضية كمقبولة جزئياً "
            "لثبوت أصل الحق "
            "مع وجود نزاع على جزء من المطالبة."
        )

    else:

        print("Explanation:")

        print(
            "القضية تحتوي على مؤشرات "
            "متعارضة ولا يمكن الجزم "
            "بالحكم بثقة عالية."
        )

    # ========================================================
    # IMPORTANT FEATURES
    # ========================================================

    print()
    print("=" * 60)
    print("IMPORTANT FEATURES")
    print("=" * 60)

    for w in top_words:

        print("-", w)

